  start --> load_source
  load_source --> check_rules
  check_rules --> robots_decision
  robots_decision -->|yes| robots_finding
  robots_decision -->|no| fetch
  robots_finding --> run_blocked
  fetch --> access_decision
  access_decision -->|yes| access_finding
  access_decision -->|no| format_decision
  access_finding --> run_blocked
  format_decision -->|no| format_finding
  format_decision -->|yes| enumerate
  format_finding --> enumerate
  enumerate --> sample
  sample --> archive
  archive --> write_findings
  write_findings --> run_done
  write_findings -->|network failure| run_failed